# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (Sample Template)
# ==============================================================================
# Copy this file to .env and replace the values with your actual configuration.
# In production (e.g., Render, Railway), configure these in your hosting dashboard.

# Port the Express server listens on (Port 5001 is chosen to prevent macOS AirPlay conflicts)
PORT=5001

# MongoDB Connection String:
# For Local MongoDB: mongodb://127.0.0.1:27017/service_request_db
# For MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/service_request_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/service_request_db

# Secret key used to sign and verify JSON Web Tokens (JWT)
# Use a strong, random, secret string in production
JWT_SECRET=btech_service_request_jwt_secret_key_2026_super_secure

# Token expiration duration (e.g. 1d, 7d, 30d, 24h)
JWT_EXPIRE=7d

# Environment mode: development or production
NODE_ENV=development
