{
  "info": {
    "_postman_id": "service-request-management-sys-2026",
    "name": "Service Request Management System API",
    "description": "REST API Collection for ITM Skills University B.Tech CSE Backend Development Assignment (Node.js, Express.js, MongoDB, JWT, RBAC, OBAC).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001/api",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "providerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "otherProviderToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('customerToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Provider Login (Plumber)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('providerToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"plumber@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Provider 2 Login (Electrician)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('otherProviderToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"electrician@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register New Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pooja Mehta\",\n  \"email\": \"pooja@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"customer\",\n  \"phone\": \"+91 9988776655\",\n  \"address\": \"Flat 101, Sunshine Heights, Mumbai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register New Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Carpenter\",\n  \"email\": \"carpenter@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"provider\",\n  \"phone\": \"+91 9112233445\",\n  \"specialization\": \"carpentry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Get Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Customer Operations",
      "item": [
        {
          "name": "Create Service Request (POST /requests)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "    pm.collectionVariables.set('requestId', json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bathroom Shower Head Clogged\",\n  \"description\": \"Low water pressure due to heavy calcium deposit buildup in the master bathroom shower.\",\n  \"category\": \"plumbing\",\n  \"priority\": \"medium\",\n  \"serviceAddress\": \"Flat 402, Lotus Residency, Mumbai\",\n  \"customerPhone\": \"+91 98765 43210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": ["{{baseUrl}}"],
              "path": ["requests"]
            }
          }
        },
        {
          "name": "Get My Requests - Customer (GET /requests/my)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests/my",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "my"]
            }
          }
        },
        {
          "name": "Get Request By ID (Ownership Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Service Provider Operations",
      "item": [
        {
          "name": "Get My Assigned Requests - Provider (GET /requests/my)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{providerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/requests/my",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "my"]
            }
          }
        },
        {
          "name": "Update Status to In-Progress (PATCH /requests/:id/status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\",\n  \"note\": \"Plumber arrived at location and commenced diagnostic testing.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            }
          }
        },
        {
          "name": "Update Status to Completed (PATCH /requests/:id/status)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"resolutionNotes\": \"Descaled the shower head, cleaned the flow restrictor, and verified full water flow.\",\n  \"note\": \"Repairs finalized and verified by customer.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Security & Authorization Verifications",
      "item": [
        {
          "name": "[403 Forbidden] Cross-Provider Tampering Check",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherProviderToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in-progress\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            },
            "description": "Tests that Provider B cannot update a request assigned to Provider A. Expects HTTP 403 Forbidden."
          }
        },
        {
          "name": "[400 Bad Request] Workflow Transition Violation",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{providerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"resolutionNotes\": \"Skipped in-progress step!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "status"]
            },
            "description": "Tests FSM validation preventing illegal jumps (e.g. assigned directly to completed). Expects HTTP 400 Bad Request."
          }
        }
      ]
    }
  ]
}
